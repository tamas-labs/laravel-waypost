{
    "name": "waypost/laravel-waypost",
    "description": "Waypost backend as a Laravel package: guard patrol rounds, chained device log, sync API, reports.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "opis/json-schema": "^2.6",
        "waypost/schema": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../waypost-schema",
            "options": {
                "symlink": true,
                "versions": {
                    "waypost/schema": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Waypost\\": "src/",
            "Waypost\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waypost\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Waypost\\WaypostServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "seed": "@php vendor/bin/testbench db:seed --class=Workbench\\\\Database\\\\Seeders\\\\DatabaseSeeder --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --host=0.0.0.0 --port=8000 --ansi"
        ],
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
