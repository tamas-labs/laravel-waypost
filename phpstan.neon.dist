includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
        - config
        - database
        - tests
        - workbench/app
        - workbench/database
        - workbench/routes
    tmpDir: build/phpstan
    ignoreErrors:
        # The package's own config file is merged into the host's config, so env() is fine there.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/waypost.php
        # A custom expectation of tests/Pest.php (expect()->extend()), registered at run time.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Pest\\Expectation<.+>::toMatchSchema\(\)\.$#'
            path: tests/*
