includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
        - config
        - tests
        - workbench/app
        - workbench/database
        - workbench/routes
    tmpDir: build/phpstan
    ignoreErrors:
        # The package's own config file is merged into the host's config, so env() is fine there.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/waypost.php
